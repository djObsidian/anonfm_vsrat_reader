# build trees
build/
build-*/
out/
cmake-build-*/
dist/

# vendored external sources (re-fetched by CMake or by the helper script).
# We KEEP vendor/cacert.pem in tree because CMake bakes it into the binary.
/vendor/wolfssl/
/vendor/curl/
/vendor/*.tar.gz
/vendor/*.zip

# editor / IDE / agent caches
.idea/
.vscode/
.vs/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# common build artefacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.exp
*.pdb

# generated by main when running --from-file scratch
test_answers.json
*.tmp
